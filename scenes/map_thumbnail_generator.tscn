[sub_resource type="GDScript" id="GDScript_dp4i4"]
resource_name = "MapThumbnailGenerator"
script/source = "extends Node3D

@export var maps_to_capture: Array[MapData]
@export var extra_chunks_to_spawn: int = 3 # Adjust this to make the track longer
@onready var sub_viewport: SubViewport = $SubViewport

func _ready() -> void:
	for map in maps_to_capture:
		if not map.base_chunk:
			continue
			
		var spawned_nodes: Array[Node3D] = []
		var next_spawn_z: float = 0.0
		
		# 1. Spawn the Base Chunk
		var base_instance: Node3D = map.base_chunk.instantiate()
		sub_viewport.add_child(base_instance)
		base_instance.global_position = Vector3(0, 0, next_spawn_z)
		spawned_nodes.append(base_instance)
		
		var end_point: Node3D = base_instance.get_node_or_null(\"EndPoint\")
		if end_point:
			next_spawn_z = end_point.global_position.z
		else:
			next_spawn_z -= 50.0
			
		# 2. Spawn Random Additional Chunks
		for i in range(extra_chunks_to_spawn):
			if map.chunks_data.is_empty(): 
				break
				
			# Filter out any empty slots just in case
			var valid_chunks = map.chunks_data.filter(func(c): return c != null and c.chunk_scene != null)
			if valid_chunks.is_empty():
				break
				
			# Pick a random chunk (simplified random for the photo booth)
			var random_chunk_data = valid_chunks.pick_random()
			var chunk_instance: Node3D = random_chunk_data.chunk_scene.instantiate()
			
			sub_viewport.add_child(chunk_instance)
			chunk_instance.global_position = Vector3(0, 0, next_spawn_z)
			spawned_nodes.append(chunk_instance)
			
			var chunk_end = chunk_instance.get_node_or_null(\"EndPoint\")
			if chunk_end:
				next_spawn_z = chunk_end.global_position.z
			else:
				next_spawn_z -= 50.0
		
		# 3. Wait for shaders and textures to load
		await get_tree().process_frame
		await get_tree().process_frame
		
		# 4. Take the Picture
		var img: Image = sub_viewport.get_texture().get_image()
		var file_name: String = map.map_name.replace(\" \", \"_\")
		var save_path: String = \"res://assets/textures/map_previews/\" + file_name + \"_preview.png\"
		
		img.save_png(save_path)
		
		# 5. Clean up the track so the next map starts with a clean slate
		for node in spawned_nodes:
			node.queue_free()
"

